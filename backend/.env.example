# Copy this file to `.env` and replace the placeholders.


# Connection details for PostgreSQL.
# Requires PostgreSQL >= 15.

DB_USER=<user>
DB_PASSWORD=<password>
DB_NAME=<db>
DATABASE_URL=postgres://<user>:<password>@localhost:5432/<db>

# Digitraffic options
DIGITRAFFIC_HEADERS={"Digitraffic-User": <user>, "Content-Type": "application/json"}
DIGITRAFFIC_GRAPHQL=https://rata.digitraffic.fi/api/v2/graphql/graphql