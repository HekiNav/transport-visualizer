# Copy this file to `.env` and replace the placeholders.

# Connection details for PostgreSQL.
# Requires PostgreSQL >= 15.
DB_USER=<user>
DB_PASSWORD=<password>
DB_NAME=<db>
DATABASE_URL=postgres://<user>:<password>@localhost:5432/<db>

# Digitraffic options
# See https://www.digitraffic.fi/en/support/instructions/#digitraffic-user for user documentation
DIGITRAFFIC_HEADERS={"Digitraffic-User": <your_user>, "Content-Type": "application/json"}
DIGITRAFFIC_GRAPHQL=https://rata.digitraffic.fi/api/v2/graphql/graphql

HSL_GRAPHQL=https://api.digitransit.fi/routing/v2/hsl/gtfs/v1
DIGITRANSIT_KEY=<api key>

# API options
API_PORT=3001
RATE_LIMIT_AMOUNT=100
RATE_LIMIT_MINUTES=5