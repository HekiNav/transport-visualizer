{
  "include": ["src/**.*"],
  "compilerOptions": {
    "rootDir": "./src",



    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "types": [
      "node",
    ],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
  }
}
